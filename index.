<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GIẢI MÃ BIỂN BÁO – Thử thách giao thông</title>
<style>
:root{--navy:#101b3d;--blue:#2457d6;--cyan:#37d5e8;--yellow:#ffd34e;--ink:#17213b;--muted:#68738d;--paper:#f5f8ff;--white:#fff;--green:#159b69;--red:#d94b58}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;background:radial-gradient(circle at 10% 10%,#314b99 0,#172653 38%,#0c1530 100%);color:var(--ink);min-height:100vh}
button{font:inherit;cursor:pointer;border:0}.shell{max-width:1050px;margin:auto;padding:22px}
.top{display:flex;align-items:center;justify-content:space-between;color:#fff;gap:12px}.brand{font-weight:900;letter-spacing:1px}.brand span{color:var(--yellow)}.pill{border:1px solid #ffffff40;border-radius:99px;padding:8px 13px;font-size:13px;color:#eaf1ff}
.hero{margin:28px 0 18px;padding:30px;border:1px solid #ffffff30;border-radius:26px;background:linear-gradient(120deg,#ffffff18,#ffffff08);color:white;position:relative;overflow:hidden}.hero:after{content:"🚦";position:absolute;font-size:125px;right:35px;top:8px;opacity:.16}.eyebrow{color:var(--cyan);font-weight:800;letter-spacing:2px;font-size:12px}.hero h1{font-size:clamp(30px,6vw,52px);line-height:1.03;margin:10px 0}.hero p{max-width:620px;color:#dce6ff;margin:12px 0 0;line-height:1.6}
.panel{background:var(--paper);border-radius:24px;padding:24px;box-shadow:0 18px 55px #050b2050}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}.stat{background:#fff;border:1px solid #e6ebf7;border-radius:16px;padding:12px;text-align:center}.stat b{display:block;font-size:23px;color:var(--blue)}.stat small{color:var(--muted)}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:5px 0 16px}.section-head h2{margin:0;font-size:21px}.tag{background:#e7edff;color:#2449b5;padding:6px 10px;border-radius:99px;font-size:12px;font-weight:800}
.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.mode{background:white;border:2px solid #e5eafa;border-radius:18px;padding:18px;text-align:left;transition:.2s}.mode:hover{transform:translateY(-3px);border-color:var(--blue);box-shadow:0 8px 20px #203e9b18}.mode .emoji{font-size:30px}.mode b{display:block;margin:8px 0 4px}.mode small{color:var(--muted);line-height:1.45}
